<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menu_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_menu_gradient"
    android:paddingStart="@dimen/screen_side_padding"
    android:paddingTop="@dimen/screen_top_padding"
    android:paddingEnd="@dimen/screen_side_padding"
    android:paddingBottom="@dimen/space_large">

    <ImageView
        android:id="@+id/menu_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.38"
        android:contentDescription="@string/cd_menu_backdrop"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/menu_bloom"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.35"
        android:importantForAccessibility="no"
        android:src="@drawable/decor_bloom_cyan"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/menu_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:text="@string/brand_title"
        android:textAppearance="@style/TextAppearance.App.Title"
        app:layout_constraintEnd_toStartOf="@id/menu_level_badge"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.fortunegem.mosaic.core.ui.StatCardView
        android:id="@+id/menu_level_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        app:statAccent="@color/accent_amber"
        app:statCompact="true"
        app:statLabel="@string/workshop_short"
        app:statValue="@string/workshop_short"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/menu_hero_card"
        style="@style/Widget.App.Card.Raised"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_large"
        android:layout_marginBottom="@dimen/space_medium"
        app:layout_constraintBottom_toTopOf="@id/menu_stat_column"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/menu_title">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/menu_hero_halo"
                android:layout_width="@dimen/hero_halo"
                android:layout_height="@dimen/hero_halo"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_gem_halo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/menu_hero_gem"
                    android:layout_width="@dimen/sprite_gem_hero"
                    android:layout_height="@dimen/sprite_gem_hero"
                    android:contentDescription="@string/cd_hero_gem"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sprite_gem_prism" />

                <TextView
                    android:id="@+id/menu_hero_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_small"
                    android:text="@string/brand_subtitle"
                    android:textAppearance="@style/TextAppearance.App.Label"
                    android:textColor="@color/primary_violet_dark" />

            </LinearLayout>

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/menu_stat_column"
        android:layout_width="0dp"
        android:layout_height="@dimen/stat_row_height"
        android:layout_marginBottom="@dimen/space_medium"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/menu_strip_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.fortunegem.mosaic.core.ui.StatCardView
            android:id="@+id/menu_stat_artworks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:statAccent="@color/accent_cyan"
            app:statLabel="@string/label_artworks"
            app:statValue="@string/stat_new" />

        <com.fortunegem.mosaic.core.ui.StatCardView
            android:id="@+id/menu_stat_best"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_medium"
            android:layout_weight="1"
            app:statAccent="@color/accent_amber"
            app:statLabel="@string/label_best"
            app:statValue="@string/stat_new" />

    </LinearLayout>

    <com.fortunegem.mosaic.core.ui.SectionHeaderView
        android:id="@+id/menu_strip_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_small"
        app:headerAccent="@color/accent_cyan"
        app:headerCaption="@string/gallery_caption"
        app:headerTitle="@string/label_artworks"
        app:layout_constraintBottom_toTopOf="@id/menu_artwork_strip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_artwork_strip"
        android:layout_width="0dp"
        android:layout_height="@dimen/chip_height"
        android:layout_marginBottom="@dimen/space_medium"
        android:clipToPadding="false"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/menu_howto_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_howto_button"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_secondary"
        android:layout_marginBottom="@dimen/space_medium"
        android:text="@string/how_it_works"
        app:layout_constraintBottom_toTopOf="@id/menu_hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.62" />

    <TextView
        android:id="@+id/menu_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="@string/menu_hint"
        android:textAppearance="@style/TextAppearance.App.Body"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/menu_play_tile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/menu_play_tile"
        android:layout_width="0dp"
        android:layout_height="@dimen/cta_tile_height"
        android:layout_marginBottom="@dimen/space_medium"
        android:background="@drawable/bg_button_primary"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/menu_gallery_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menu_play_button"
            style="@style/Widget.App.Button.Cta"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/play"
            app:icon="@drawable/ic_gem_cut" />

    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_gallery_button"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_secondary"
        android:layout_marginEnd="@dimen/space_small"
        android:text="@string/gem_gallery"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/menu_settings_button"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/menu_settings_button"
        style="@style/Widget.App.Button.Secondary"
        android:layout_width="0dp"
        android:layout_height="@dimen/button_height_secondary"
        android:layout_marginStart="@dimen/space_small"
        android:text="@string/settings"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/menu_gallery_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
