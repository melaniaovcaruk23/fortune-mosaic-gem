<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gallery_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:padding="@dimen/space_large">

    <com.fortunegem.mosaic.core.ui.SectionHeaderView
        android:id="@+id/gallery_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:headerAccent="@color/accent_cyan"
        app:headerCaption="@string/gallery_caption"
        app:headerTitle="@string/gallery_title" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gallery_list"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gallery_height"
        android:layout_below="@id/gallery_header"
        android:layout_marginTop="@dimen/space_medium"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gallery_close_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height_primary"
        android:layout_below="@id/gallery_list"
        android:layout_marginTop="@dimen/space_medium"
        android:text="@string/close"
        style="@style/Widget.App.Button.Primary"
        app:icon="@drawable/ic_close" />

</RelativeLayout>
